{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
"build": {
  "development": {
    "developmentClient": true,
    "distribution": "internal"
  },
  "preview": {
    "distribution": "internal"
  },
  "preview-simulator": {
    "extends": "preview",
    "ios": {
      "simulator": true
    },
    "env": {
      "EXPO_PUBLIC_API_URL": "https://shopfront-api-joshua.onrender.com/api/v1/api/v1"
    }
  },
  "production": {
    "autoIncrement": true,
    "env": {
      "EXPO_PUBLIC_API_URL": "https://shopfront-api-joshua.onrender.com/api/v1/api/v1"
    }
  }
}
}
